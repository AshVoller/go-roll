current:

    List: list to scroll
        {Axis:vertical, ScrollToEnd:false}
        Flex: whole page
            {Vertical}

            Rigid:
                Spacer:
                    {H: 50}

            Rigid:
                {H: 100,300}
                Body2: Roll Output
            Rgiid:
                {H: 250,250}
                Margin Output:
                    {T: 0, B: 40, R: 170, L: 170}
                    Border Output:
                        {Color:204,204,204,255} {C:3, W:2}
                        Editor Output Box: Enter num dice...
                            {LineHight:10, ReadOnly:true}

            Rigid:
                Center:
                    Margins Text: {T:40, B:20, R:170, L:170}
                        Flex: Text Inputs
                            {Horizontal}

                            Rigid:
                                {W: 100,300}
                                Body2: Number of Dice
                            Rigid:
                                Spacer:
                                    {W: 5}
                            Rigid:
                                {W: 50, 50}
                                Border Text:
                                    {Color:204,204,204,255} {C:3, W:2}
                                    Editor numDice: 1
                                        {SingleLine:true, Align: Middle}

                            Rigid:
                                Spacer:
                                    {W: 20}

                            Rigid:
                                {W: 100,300}
                                Body2: Number of Faces on Dice
                            Rigid:
                                Spacer:
                                    {W: 5}
                            Rigid:
                                {W: 50,50}
                                Border text:
                                    {Color:204,204,204,255} {C:3, W:2}
                                    Editor typeDice: 20
                                        {SingleLine:true, Align: Middle}

                            Rigid:
                                Spacer:
                                    {W: 20}

                            Rigid:
                                {W: 100,300}
                                Body2: +/- to dice roll
                            Rigid:
                                Spacer:
                                    {W: 5}
                            Rigid:
                                {W: 50,50}
                                Border text:
                                    {Color:204,204,204,255} {C:3, W:2}
                                    Editor addRoll: 0
                                        {SingleLine:true, Align: Middle}

            Rigid:
                Margins Roll:
                    {T:0, B:25, R:160 , L:160}
                    Clickable rolloutton: 
                        button btn: Roll

            Rigid:
                Spacer:
                    {H: 25}

            Rigid:
                {H: 250,250}
                Body2: Roll History
            Rigid:
                Margin Output:
                    {T: 0, B: 40, R: 170, L: 170}
                    Border Output:
                        {Color:204,204,204,255} {C:3, W:2}
                        Editor History Box: Roll History
                            {LineHight:10, ReadOnly:true}
